# ── ShortsFactory · .env (einfach als „.env“ im Projektroot speichern) ──────
# Nach jeder Änderung: Server einmal neu starten (Strg+C → npm start).

# Passwortschutz für die Seite (empfohlen, wenn die App im Netz erreichbar ist).
# Klartext-Passwort — bleibt ausschließlich auf diesem Rechner.
#APP_PASSWORD=ganz-langes-passwort

# Alternative: statt Klartext den SHA-256-Hash des Passworts.
# Erzeugen mit:  npm run password:hash
#APP_PASSWORD_HASH=

# Fehlversuche bis zur IP-Sperre (Standard 5) und Sperr-Stufen in Minuten.
#APP_MAX_ATTEMPTS=5
#APP_LOCKOUT_MINUTES=5,15,60,360,1440

# Gültigkeit der Sitzung in Sekunden (Standard 43200 = 12 h)
#APP_SESSION_TTL=43200

# Zernio API-Key (https://zernio.com → API) — damit geht der Versand raus.
# Ohne Key arbeitet die Fabrik, das Versand-Panel bleibt gesperrt.
#ZERNIO_API_KEY=sk_…

# Port des eingebauten Servers (Standard 8080). Bindet an 0.0.0.0 (Heimnetz).
#PORT=8080
